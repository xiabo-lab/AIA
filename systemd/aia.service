[Unit]
Description=AIA voice assistant
After=aia-whisper.service
Wants=aia-whisper.service
# Retry forever, on purpose. The commonest reason this exits non-zero is
# whisper-server not answering within 60 s, and on a device that starts with
# the car the right response is to keep trying rather than to give up at some
# arbitrary count and stay dead until somebody notices. Systemd's default
# would stop after 5 starts in 10 s; the 60 s wait means that never triggers
# anyway, so this states the intent rather than leaving it to arithmetic.
StartLimitIntervalSec=0


[Service]
Type=simple

# The conversation overlay is a Wayland layer-shell surface, so it needs a
# compositor. A user service starts as soon as the session manager does,
# which can be before labwc has created its socket — the same race
# kodama-lite.service solves the same way. Without this the overlay starts,
# finds no compositor, exits, and the assistant runs blind: still listening
# and answering, but with nothing on screen and no obvious reason why.
Environment=WAYLAND_DISPLAY=wayland-0
ExecStartPre=/bin/sh -c 'until [ -e "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ]; do sleep 1; done'

ExecStart=%h/AI_Assit/.venv/bin/python -m aia.main
WorkingDirectory=%h/AI_Assit

# Keep the most recent captured utterances — the only honest input for
# diagnosing a misrecognition after the fact, since the alternative is asking
# the user to reproduce it, which they often cannot. Measured at ~148 KB each
# rather than the "few KB" this comment used to claim, so `keep_utterances`
# in config.py bounds the directory at roughly a week and ~30 MB; without a
# bound this writes to the SD card on every turn, forever.
#
# It is also a standing recording of everything said in the room. Drop this
# line if that is unwanted.
Environment=AIA_SAVE_AUDIO=1

# Unbuffered, so `journalctl -f` shows a turn as it happens rather than in
# 4 KB bursts. This is the log you read when someone says "it didn't hear me".
Environment=PYTHONUNBUFFERED=1

# The microphone is exclusive: exactly one reader. A crashed instance that
# systemd restarts too eagerly can collide with the dying one still holding
# the device, so the restart is unhurried.
Restart=on-failure
RestartSec=5


# Loading the wake model, both Piper voices and waiting for whisper-server.
TimeoutStartSec=120

# Speech recognition and the wake word are CPU-hungry, but the foreground
# app must stay responsive: the spec asks for exactly this. A positive nice
# value keeps the assistant off the display's back under load.
Nice=5

[Install]
WantedBy=default.target
