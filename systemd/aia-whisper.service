[Unit]
Description=AIA speech recognition (whisper.cpp server)
Documentation=https://github.com/ggml-org/whisper.cpp
# Started before the assistant, but the assistant does not *require* it:
# aia.service waits for this to answer and reports a clear error if it never
# does, which is friendlier than systemd refusing to start anything.
Before=aia.service

[Service]
Type=simple
# Run through bash rather than executing the script directly, so this does
# not depend on a file mode. `core.fileMode` is false on the Windows checkout
# this is authored from, and the first deploy that included scripts/ stripped
# +x from all six .sh files — surfacing hours later as this unit in a restart
# loop with 203/EXEC while the assistant sat in "waiting for whisper-server",
# a symptom that points at whisper, the model, the port, anything but a
# permission bit. The bit is correct in git and install-service.sh sets it
# too; this removes the dependency rather than defending it a third time.
ExecStart=/bin/bash %h/AI_Assit/scripts/whisper-server.sh
WorkingDirectory=%h/AI_Assit

# The model lives in memory for the life of the process — that is the whole
# point of running a server rather than invoking the CLI per utterance, and
# it is an architectural requirement of the latency budget, not a tuning
# choice. See docs/PLAN.md, "M0".
Restart=on-failure
RestartSec=3

# Loading ggml-base takes well under a second, but a cold SD card after boot
# is slower than a warm one.
TimeoutStartSec=60

[Install]
WantedBy=default.target
