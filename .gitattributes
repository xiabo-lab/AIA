# This repo is authored on Windows and runs on Raspberry Pi OS. Anything the
# Pi executes must arrive with LF endings — a CRLF shebang fails with the
# famously unhelpful "bad interpreter: /usr/bin/env bash^M".
*.sh    text eol=lf
*.py    text eol=lf
*.service text eol=lf
*.desktop text eol=lf
# Workflows are run by bash on a Linux runner, so the same rule applies: a
# CRLF `run:` block hands the shell a \r at the end of every line, and the
# errors that produces name the last word of the line rather than the ending.
*.yml   text eol=lf
*.yaml  text eol=lf

# Model weights and audio are binary; never let git touch them.
*.bin   binary
*.gguf  binary
*.onnx  binary
*.wav   binary

# Generated from plugin.manifest() — regenerate rather than editing.
commands.txt   text eol=lf
commands.html  text eol=lf

# Served to a browser by aia/ui/server.py, so the same LF rule applies for the
# same reason as everything else the Pi executes.
*.html  text eol=lf

# The version AIA reports comes from the tag it was archived at, and this is
# what substitutes it. The Pi has no .git — it is deployed with
# `git archive <tag> aia scripts | ssh …` — so without this line the settings
# page falls back to `git describe`, which cannot run there, and reports
# "unknown". See aia/_version.py.
aia/_version.py  export-subst
